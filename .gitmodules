# The repositories are still named lazyos-*; renaming them to hayato-* is
# the maintainer's step (specs/026-hayato-rebrand.md), and this file moves
# with them in one commit.
[submodule "core"]
	path = core
	url = https://github.com/Brunux/lazyos-core.git
[submodule "desktop"]
	path = desktop
	url = https://github.com/Brunux/lazyos-desktop.git
[submodule "devices"]
	path = devices
	url = https://github.com/Brunux/lazyos-devices.git
